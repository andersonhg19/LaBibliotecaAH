# Copiar a .env y completar. Nunca subir .env al repo.
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=
SECRET=
# Vida del token en ms (24 h). La web lo renueva con /v1/auth/renovar.
EXP_TIME=86400000
# Alta publica (/v1/auth/register): false = solo un ADMIN crea cuentas.
REGISTRO_PUBLICO=false
# Proxies de confianza delante de auth-service (Tailscale serve + gateway = 2; sin Tailscale = 1).
LOGIN_PROXIES_CONFIABLES=2
# Segundos que biblioteca-service recuerda que una sesion sigue vigente (revocacion tardia maxima).
SESION_CACHE_SEGUNDOS=30
# Topes de subida: tamano por archivo, por peticion, archivos por peticion, espacio libre minimo en /datos (MB)
# y colecciones por usuario.
BIBLIOTECA_MAX_ARCHIVO=300MB
BIBLIOTECA_MAX_SUBIDA=1GB
BIBLIOTECA_MAX_ARCHIVOS_POR_SUBIDA=20
BIBLIOTECA_ESPACIO_MINIMO_MB=1024
BIBLIOTECA_MAX_ESTANTES=100
SEED_ADMIN_PASSWORD=
SEED_ANDERSON_PASSWORD=
SEED_SAMY_PASSWORD=
# Carpeta de libros y audio en el host (casa: E:/LaBibliotecaAH)
DATOS_HOST=./datos-dev
# URL publica del gateway que usa la web (casa: https://casa.tail60fcb5.ts.net:7051)
API_URL=http://localhost:8920
BUZON_USUARIOS=
# Traductor autoalojado (servicio traductor del compose, Opus-MT + CTranslate2; contratos v1.3.1). Idiomas con
# modelo en la imagen, hilos de CTranslate2 por lote, lotes a la vez, beam (4 = calidad de referencia), y frenos
# por usuario en biblioteca-service: caracteres por minuto (textos sueltos) y capitulos nuevos por hora.
TRADUCTOR_URL=http://traductor:5000
TRADUCTOR_IDIOMAS=en,es
TRADUCTOR_HILOS=4
TRADUCTOR_LOTES_PARALELOS=1
TRADUCTOR_BEAM=4
TRADUCTOR_CARACTERES_POR_MINUTO=20000
TRADUCTOR_CAPITULOS_POR_HORA=30
TAG=latest
# Origenes permitidos por el gateway, separados por coma (casa: https://casa.tail60fcb5.ts.net:7050)
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:8081
# Puertos locales (127.0.0.1). Cambiarlos solo para una segunda instancia (QA) en la misma maquina.
PUERTO_POSTGRES=5433
PUERTO_DISCOVERY=8860
PUERTO_GATEWAY=8920
PUERTO_AUTH=8921
PUERTO_BIBLIOTECA=8925
PUERTO_TALLER=8926
PUERTO_WEB=3100
