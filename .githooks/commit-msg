#!/bin/sh
# Commits convencionales: tipo(alcance opcional): descripcion
# Tipos: feat fix docs style refactor perf test build ci chore revert
patron='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9#._-]+\))?!?: .{3,}'
primera=$(head -n1 "$1")
case "$primera" in Merge*|Revert*) exit 0;; esac
if ! echo "$primera" | grep -Eq "$patron"; then
  echo "FALLA: el mensaje no sigue commits convencionales."
  echo "  Ejemplo: feat(biblioteca): filtros por autor y genero"
  echo "  Recibido: $primera"
  exit 1
fi
