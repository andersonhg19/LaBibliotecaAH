{
  "components" : {
    "schemas" : {
      "AppConfigSaveDTO" : {
        "properties" : {
          "configKey" : {
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          },
          "description" : {
            "maxLength" : 300,
            "minLength" : 0,
            "type" : "string"
          },
          "value" : {
            "maxLength" : 300,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [
          "configKey",
          "value"
        ],
        "type" : "object"
      },
      "AsignarRolesDTO" : {
        "properties" : {
          "roles" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [
          "roles"
        ],
        "type" : "object"
      },
      "AuditoriaFilterDTO" : {
        "properties" : {
          "actorUserId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "entityType" : {
            "type" : "string"
          },
          "page" : {
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "maximum" : 200,
            "minimum" : 1,
            "type" : "integer"
          },
          "ultimosDias" : {
            "format" : "int32",
            "maximum" : 3650,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "AuthenticationRequest" : {
        "properties" : {
          "email" : {
            "deprecated" : true,
            "description" : "Sinonimo retrocompatible de 'usuario' (correo o alias)",
            "example" : "anderson@biblioteca.ah",
            "type" : "string"
          },
          "password" : {
            "example" : "Clave1234",
            "type" : "string"
          },
          "usuario" : {
            "description" : "Correo o alias de la cuenta",
            "example" : "anderson",
            "type" : "string"
          }
        },
        "required" : [
          "password"
        ],
        "type" : "object"
      },
      "PermisoSaveDTO" : {
        "properties" : {
          "canCreate" : {
            "type" : "boolean"
          },
          "canDelete" : {
            "type" : "boolean"
          },
          "canRead" : {
            "type" : "boolean"
          },
          "canUpdate" : {
            "type" : "boolean"
          },
          "pageId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "roleName" : {
            "type" : "string"
          }
        },
        "required" : [
          "canCreate",
          "canDelete",
          "canRead",
          "canUpdate",
          "pageId",
          "roleName"
        ],
        "type" : "object"
      },
      "ResultDTO" : {
        "properties" : {
          "correct" : {
            "type" : "boolean"
          },
          "errorCode" : {
            "format" : "int32",
            "type" : "integer"
          },
          "message" : {
            "type" : "string"
          },
          "object" : {
            "type" : "object"
          }
        },
        "type" : "object"
      },
      "RoleSaveDTO" : {
        "properties" : {
          "active" : {
            "type" : "boolean"
          },
          "description" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "name" : {
            "maxLength" : 50,
            "minLength" : 0,
            "pattern" : "^[A-Z][A-Z0-9_]*$",
            "type" : "string"
          }
        },
        "required" : [
          "name"
        ],
        "type" : "object"
      },
      "UserFilterDTO" : {
        "properties" : {
          "active" : {
            "type" : "boolean"
          },
          "email" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "page" : {
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "UserRegisterDTO" : {
        "properties" : {
          "alias" : {
            "description" : "Alias para iniciar sesion: 3-30 caracteres [a-z0-9._-], sin @",
            "example" : "anderson",
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "email" : {
            "maxLength" : 150,
            "minLength" : 0,
            "type" : "string"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 100,
            "minLength" : 10,
            "pattern" : "^(?=.*\\p{L})(?=.*\\d).*$",
            "type" : "string"
          }
        },
        "required" : [
          "alias",
          "email",
          "name",
          "password"
        ],
        "type" : "object"
      },
      "UserSaveDTO" : {
        "properties" : {
          "alias" : {
            "description" : "Alias para iniciar sesion: 3-30 caracteres [a-z0-9._-], sin @. Al editar, si no llega se conserva",
            "example" : "anderson",
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "currentPassword" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "email" : {
            "maxLength" : 150,
            "minLength" : 0,
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 100,
            "minLength" : 10,
            "pattern" : "^(?=.*\\p{L})(?=.*\\d).*$",
            "type" : "string"
          }
        },
        "required" : [
          "email",
          "name"
        ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "El token que devuelve /v1/auth/login",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Usuarios, registro, login y emision del JWT.\n\nTodos los endpoints son POST y devuelven HTTP 200 con un\nResultDTO: { correct, message, errorCode, object }. Cuando algo\nfalla, `correct` viene en false y `errorCode` imita al codigo\nHTTP que no se envia.\n\nLa identidad sale del claim del JWT, nunca del cuerpo: el userId\nque se mande al consultar o al modificar se ignora.",
    "title" : "La Biblioteca AH — auth-service",
    "version" : "1.0.0"
  },
